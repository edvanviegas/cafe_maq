# =====================================================================
# CafeMaq - configurações. Copie este arquivo para ".env" e preencha.
# O .env fica fora do GitHub (.gitignore): nunca coloque senhas no código.
# =====================================================================

# desenvolvimento | producao   (em produção: cookie só por HTTPS, sem modo debug, SECRET_KEY obrigatória)
AMBIENTE=desenvolvimento

# Chave que assina a sessão. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ---------------- Banco de dados ----------------
# mysql (oficial do projeto) | sqlite (teste rápido, sem instalar nada)
DB_TIPO=mysql
DB_HOST=localhost
DB_PORTA=3306
DB_NOME=cafemaq
# Usuário da APLICAÇÃO criado no 02_usuarios.sql (permissões restritas). Nunca use o root aqui.
DB_USUARIO=cafemaq_app
DB_SENHA=

# ---------------- Backup (scripts/backup.py) ----------------
BACKUP_USUARIO=cafemaq_backup
BACKUP_SENHA=
BACKUP_MANTER=7

# ---------------- Segurança ----------------
# Minutos parado até a sessão expirar
SESSAO_INATIVIDADE_MIN=30
# Senhas erradas permitidas por IP/e-mail dentro da janela (em minutos) antes de bloquear
LOGIN_MAX_TENTATIVAS=5
LOGIN_JANELA_MIN=15

# ---------------- Login com Google (opcional) ----------------
# ID do cliente OAuth (Aplicativo da Web). Vazio = esconde o botão do Google.
GOOGLE_CLIENT_ID=
